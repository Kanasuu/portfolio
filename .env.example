# Public URL of the deployed site, used for canonical links, Open Graph and sitemap.
# Set this in Vercel (Project → Settings → Environment Variables) after the first deploy.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# --- AI Recruiter chat (server-side only; never prefix these with NEXT_PUBLIC_) ---
# Create a key at https://console.anthropic.com/settings/keys (API usage is billed separately
# from any Claude subscription). Set it in .env.local locally and in Vercel's Environment Variables.
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5).
ANTHROPIC_MODEL=
# Optional: extra comma-separated origins allowed to call the chat API (same-origin is always allowed).
RECRUITER_ALLOWED_ORIGINS=
